# Copiar este archivo como configs/.dev.env, configs/.tst.env o configs/.pro.env
# y completar los valores. Los .env reales no se versionan.

# Proceso
PROCESS_ENV=dev
PROCESS_NAME=Emision Plan Familia VAVI

# Correo (relay SMTP interno)
SMTP_SERVER=smtp.ejemplo.local
SMTP_PORT=25
PROCESS_EMAIL=robot@ejemplo.com
# Varias casillas separadas por coma
PROCESS_ERROR_EMAILS=
PROCESS_SUCCESS_EMAILS=

# Rutas (relativas a la raíz del proyecto o absolutas)
LOGS=./logs
INPUTS=./SOLICITUDES SALUD VAVI-RETIRO
OUTPUTS=./output
TEMPLATES=./templates
MAIL_TEMPLATES=./Plantillas

# Notificaciones
NOTIFY_ENABLED=false
MAIL_SAVE_LOCAL=true

# Microsoft Graph / SharePoint (app-only con certificado)
GRAPH_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_THUMBPRINT=
# Vacío = usa el certificado del store de Windows (CurrentUser\My) por thumbprint
GRAPH_CERT_PATH=
GRAPH_SITE_ID=
GRAPH_LIST_ID=
GRAPH_VAVI_ROOT=SOLICITUDES SALUD VAVI-RETIRO
GRAPH_SALIDA=_salida
